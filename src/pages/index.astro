---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const url = (path: string) => getRelativeLocaleUrl(locale, path);

const posts = getSortedPosts(await getCollection("posts")).slice(0, 3);

// Tous les boutons de contact mènent à la page /contact.
const contactUrl = url("contact");

const pandaUrl = "https://github.com/Naofel-eal/PANDA";

const stats = [
  {
    value: "Senior",
    unit: "",
    label: "niveau évalué par un grand groupe du CAC 40",
  },
  { value: "Major", unit: "", label: "de promotion, Polytech Dijon" },
  {
    value: "2×",
    unit: "",
    label: "vainqueur du CTF TotalEnergies (2024, 2025)",
  },
];

const services = [
  {
    title: "IA agentique & agents de code",
    text: "Conception d'agents IA autonomes intégrés à votre cycle de développement : ils prennent un ticket, implémentent, ouvrent la pull request et traitent la revue.",
    tags: [
      "Orchestration d'agents",
      "Sous-agents",
      "Context engineering",
      "Harness engineering",
      "MCP",
      "Skills",
      "Human-in-the-loop",
    ],
    icon: "M12 3v2m0 14v2M5 12H3m18 0h-2M7.05 7.05 5.636 5.636m12.728 12.728-1.414-1.414M7.05 16.95l-1.414 1.414M18.364 5.636 16.95 7.05M9 12a3 3 0 1 0 6 0 3 3 0 0 0-6 0Z",
  },
  {
    title: "Architecture logicielle & DDD",
    text: "Modélisation du domaine métier et architectures qui durent. Refonte de systèmes existants pour réduire la dette technique sans tout réécrire.",
    tags: [
      "Domain-Driven Design",
      "Architecture hexagonale",
      "Clean Architecture",
    ],
    icon: "M12 3 3 7.5l9 4.5 9-4.5L12 3Zm-9 9 9 4.5 9-4.5M3 16.5 12 21l9-4.5",
  },
  {
    title: "Développement full-stack",
    text: "Des produits livrés de bout en bout, du cadrage à la production, avec une CI/CD fiable et un code testé.",
    tags: [
      "Java · Spring Boot · Quarkus",
      "Angular",
      "Test-Driven Development",
      "Azure · AWS",
      "Docker",
    ],
    icon: "M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm-1 4h18M7 7h.01M10 7h.01",
  },
  {
    title: "Accompagnement & formation",
    text: "Tech lead, revue de code et montée en compétence des équipes sur l'architecture, le BDD et le développement assisté par IA.",
    tags: [
      "Tech lead",
      "Behavior-Driven Development",
      "Développement augmenté par l'IA",
    ],
    icon: "M17 20h5v-2a3 3 0 0 0-5.36-1.86M17 20H7m10 0v-2c0-.66-.13-1.28-.36-1.86M7 20H2v-2a3 3 0 0 1 5.36-1.86M7 20v-2c0-.66.13-1.28.36-1.86m0 0a5 5 0 0 1 9.28 0M15 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
  },
];

const pandaPhases = [
  {
    n: "01",
    title: "Comprendre",
    text: "L'agent explore le code en lecture seule et valide sa compréhension du ticket.",
  },
  {
    n: "02",
    title: "Implémenter",
    text: "Il modifie le code, lance les tests et ouvre la pull request.",
  },
  {
    n: "03",
    title: "Itérer",
    text: "Chaque commentaire de revue ou retour métier relance un cycle ciblé.",
  },
];

const steps = [
  {
    n: "01",
    title: "Modéliser le domaine",
    text: "Ateliers avec le métier pour établir un langage commun et découper le système en contextes clairs.",
  },
  {
    n: "02",
    title: "Spécifier par l'exemple",
    text: "Le comportement attendu est écrit en scénarios BDD, lisibles par tous et exécutés comme tests.",
  },
  {
    n: "03",
    title: "Livrer avec des agents, sous contrôle",
    text: "Tests automatisés avec 100 % de couverture du domaine, puis agents reviewers, skills et MCP : tout est vérifié avant la validation humaine.",
  },
  {
    n: "04",
    title: "Documenter comme on code",
    text: "La documentation est versionnée avec le code et évolue avec lui : c'est le contexte le plus fiable qu'on puisse donner à un agent. Un workflow GitHub la publie ensuite automatiquement dans Confluence.",
  },
];

const security = [
  {
    title: "Connexions satellites sécurisées",
    text: "Chez CYSEC, sécurisation de connexions satellites en orbite basse via Starlink : chiffrement embarqué sur routeur, gestion des clés sur TPM et VPN haute performance.",
    icon: "M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Zm-3 9 2 2 4-4",
  },
  {
    title: "2× vainqueur du CTF TotalEnergies",
    text: "1ʳᵉ place en 2024 puis en 2025 : vulnérabilités web, sécurité du cloud et de l'IA, cryptographie, reverse engineering et OSINT.",
    icon: "M8 21h8m-4-4v4M7 4h10v5a5 5 0 0 1-10 0V4Zm0 2H4v1a3 3 0 0 0 3 3m10-4h3v1a3 3 0 0 1-3 3",
  },
  {
    title: "Bug bounty",
    text: "Chasse aux vulnérabilités sur des programmes de bug bounty depuis 2026, pour garder un regard d'attaquant sur le code que je conçois.",
    icon: "M8 8a4 4 0 1 1 8 0v1H8V8Zm-2 3h12v3a6 6 0 0 1-12 0v-3Zm6 0v9M3 13h3m12 0h3M4 7l2.5 2M20 7l-2.5 2M4 20l2.5-2.5M20 20l-2.5-2.5",
  },
];

const experiences = [
  {
    company: "TotalEnergies",
    team: "Digital Factory",
    role: "Ingénieur full-stack senior · Tech lead par intérim",
    years: "2024 – 2026",
  },
  {
    company: "APRR",
    team: "Autoroutes Paris-Rhin-Rhône",
    role: "Ingénieur full-stack",
    years: "2023 – 2024",
  },
  {
    company: "CYSEC",
    team: "Lausanne",
    role: "Ingénieur cybersécurité",
    years: "2023",
  },
];
---

<Layout>
  <Header />

  <main id="main-content">
    <!-- Hero -->
    <section class="hero wide-layout">
      <div class="glow" aria-hidden="true"></div>
      <p class="pill reveal">
        <span class="dot" aria-hidden="true"></span>
        <span class="hide-xs">Ingénieur logiciel senior ·</span> Disponible en freelance
      </p>
      <h1 class="reveal">
        Des agents IA qui livrent.<br />
        <span class="gradient-text">Du code qui dure.</span>
      </h1>
      <p class="lead-text lead reveal">
        J'aide les équipes tech à intégrer l'<strong>IA agentique</strong> dans leur
        cycle de développement, sur des fondations solides&nbsp;:{" "}
        <strong>Domain-Driven Design</strong>, architecture hexagonale et BDD.
      </p>
      <div class="actions reveal">
        <a href={contactUrl} class="btn-primary">Discutons de votre projet</a>
        <a href={url("about")} class="link-arrow">Découvrir mon parcours</a>
      </div>
    </section>

    <!-- Chiffres clés -->
    <section class="wide-layout" aria-label="Chiffres clés">
      <dl class="stats">
        {
          stats.map(s => (
            <div class="stat reveal">
              <dt class="sr-only">{s.label}</dt>
              <dd class="stat-value">
                {s.value}
                {s.unit && <span class="stat-unit">{s.unit}</span>}
              </dd>
              <dd class="stat-label">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Expertise -->
    <section class="section wide-layout">
      <p class="eyebrow reveal">Expertise</p>
      <h2 class="display-title reveal">Ce que je fais.</h2>
      <div class="grid-2">
        {
          services.map(s => (
            <article class="surface-card is-link card reveal">
              <span class="card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d={s.icon} />
                </svg>
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <ul class="card-tags">
                {s.tags.map(t => (
                  <li>{t}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Méthode -->
    <section class="section wide-layout">
      <p class="eyebrow reveal">Méthode</p>
      <h2 class="display-title reveal">
        Un agent n'est bon que si son contexte l'est.
      </h2>
      <p class="lead-text section-lead reveal">
        Le DDD, le BDD et une documentation à jour donnent à l'agent un
        vocabulaire métier précis et des comportements vérifiables. Les tests et
        les contrôles automatisés vérifient chaque ligne qu'il écrit.
      </p>
      <ol class="grid-4 steps">
        {
          steps.map(s => (
            <li class="step reveal">
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Étude de cas PANDA -->
    <section id="panda" class="section wide-layout">
      <div class="case surface-card reveal">
        <div class="case-head">
          <p class="eyebrow">Étude de cas</p>
          <h2 class="display-title">
            PANDA transforme vos tickets Jira en <span class="gradient-text"
              >pull requests.</span
            >
          </h2>
          <p class="lead-text">
            Un orchestrateur d'agents IA autonomes que j'ai conçu seul, déployé
            dans 80&nbsp;% des équipes de la TotalEnergies Digital Factory. Un
            ticket arrive dans Jira&nbsp;: l'agent le prend en charge, code,
            ouvre la pull request sur GitHub et suit les retours jusqu'à la
            validation. L'humain reste dans la boucle à chaque étape.
          </p>
        </div>
        <ol class="phases">
          {
            pandaPhases.map(p => (
              <li class="phase">
                <span class="step-n">{p.n}</span>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="case-foot">
          <p>
            <strong>Résultat&nbsp;:</strong> plus de 400 tickets livrés en quelques
            mois, dans 80&nbsp;% des équipes de la Digital Factory.
          </p>
          <a href={pandaUrl} class="link-arrow" target="_blank" rel="noopener"
            >Voir le projet sur GitHub</a
          >
        </div>
      </div>
    </section>

    <!-- Cybersécurité -->
    <section class="section wide-layout">
      <p class="eyebrow reveal">Cybersécurité</p>
      <h2 class="display-title reveal">La sécurité, dès la conception.</h2>
      <p class="lead-text section-lead reveal">
        Un code bien architecturé est un code plus facile à sécuriser. Je garde
        un regard d'attaquant sur tout ce que je construis, agents IA compris.
      </p>
      <div class="grid-3">
        {
          security.map(s => (
            <article class="surface-card is-link card reveal">
              <span class="card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d={s.icon} />
                </svg>
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Parcours -->
    <section class="section wide-layout">
      <p class="eyebrow reveal">Parcours</p>
      <h2 class="display-title reveal">Des environnements exigeants.</h2>
      <ul class="xp">
        {
          experiences.map(e => (
            <li class="xp-row reveal">
              <div>
                <p class="xp-company">{e.company}</p>
                <p class="xp-team">{e.team}</p>
              </div>
              <p class="xp-role">{e.role}</p>
              <p class="xp-years">{e.years}</p>
            </li>
          ))
        }
      </ul>
      <a href={url("about")} class="link-arrow xp-more reveal"
        >Parcours complet</a
      >
    </section>

    <!-- Articles -->
    {
      posts.length > 0 && (
        <section class="section wide-layout">
          <div class="section-head">
            <div>
              <p class="eyebrow reveal">Le blog</p>
              <h2 class="display-title reveal">Derniers articles.</h2>
            </div>
            <a href={url("posts")} class="link-arrow reveal">
              Tous les articles
            </a>
          </div>
          <ul class="grid-3 posts">
            {posts.map(post => (
              <Card {...post} variant="h3" />
            ))}
          </ul>
        </section>
      )
    }

    <!-- CTA -->
    <section class="cta reveal">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-dots" aria-hidden="true"></div>
      <p class="eyebrow">Travaillons ensemble</p>
      <h2 class="display-title">
        Un projet <span class="gradient-text">en tête&nbsp;?</span>
      </h2>
      <p class="lead-text">
        Agents IA, refonte d'architecture ou nouveau produit&nbsp;: parlons-en,
        simplement et sans engagement.
      </p>
      <a href={contactUrl} class="btn-primary">Me contacter</a>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-top: clamp(88px, 14vw, 168px);
    padding-bottom: clamp(48px, 7vw, 96px);
    text-align: center;
  }
  .glow {
    position: absolute;
    inset: -10% -20% auto;
    height: 720px;
    background: var(--glow);
    filter: blur(20px);
    z-index: -1;
    pointer-events: none;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 980px;
    background: var(--surface);
    color: var(--muted-foreground);
    font-size: 13px;
    box-shadow: var(--shadow-card);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent);
  }
  .hero h1 {
    margin: 28px auto 0;
    font-size: clamp(42px, 8vw, 88px);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.045em;
    max-width: 20ch;
    text-wrap: balance;
  }
  .lead {
    margin: 28px auto 0;
    max-width: 38rem;
  }
  .actions {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px 28px;
  }

  /* ---------- Sections ---------- */
  .section {
    padding-top: clamp(64px, 9vw, 112px);
  }
  .section h2 {
    margin-top: 8px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
  }
  .grid-3 {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .card {
    padding: 32px 28px 36px;
  }
  .card-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }
  .card-icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .card h3,
  .step h3 {
    margin-top: 22px;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .card p,
  .step p {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  .step {
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .step-n {
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
  }
  .step h3 {
    margin-top: 12px;
  }
  .posts {
    margin-top: 40px;
  }
  .posts:has(> :only-child) {
    grid-template-columns: minmax(0, 640px);
  }

  /* ---------- CTA ---------- */
  /* Clair : panneau lumineux teinté, trame de points. Sombre : panneau noir. */
  .cta {
    --cta-bg: linear-gradient(180deg, #f3f8ff 0%, #f8f5ff 55%, #ffffff 100%);
    --cta-text: #1d1d1f;
    --cta-text-2: #424245;
    --cta-accent: var(--accent);
    --cta-border: rgba(0, 113, 227, 0.14);
    --cta-dot: rgba(0, 113, 227, 0.22);
    --cta-glow-1: rgba(0, 113, 227, 0.14);
    --cta-glow-2: rgba(122, 92, 255, 0.1);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: min(calc(100% - 40px), calc(var(--max-wide) - 40px));
    margin: clamp(80px, 11vw, 136px) auto 0;
    padding: clamp(72px, 10vw, 120px) 24px;
    text-align: center;
    color: var(--cta-text);
    background: var(--cta-bg);
    border-radius: 32px;
    border: 1px solid var(--cta-border);
    box-shadow: var(--shadow-card);
  }
  :global([data-theme="dark"]) .cta {
    --cta-bg: #111114;
    --cta-text: #f5f5f7;
    --cta-text-2: rgba(245, 245, 247, 0.72);
    --cta-border: rgba(255, 255, 255, 0.1);
    --cta-dot: rgba(255, 255, 255, 0.07);
    --cta-glow-1: rgba(41, 151, 255, 0.28);
    --cta-glow-2: rgba(167, 139, 250, 0.22);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }
  /* Liseré lumineux sur le bord supérieur */
  .cta::before {
    content: "";
    position: absolute;
    top: 0;
    left: 15%;
    right: 15%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(41, 151, 255, 0.9),
      rgba(167, 139, 250, 0.9),
      transparent
    );
  }
  /* Lueur douce venant du haut */
  .cta-glow {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      radial-gradient(60% 55% at 50% 0%, var(--cta-glow-1), transparent 70%),
      radial-gradient(40% 40% at 50% 0%, var(--cta-glow-2), transparent 70%);
  }
  /* Trame de points, estompée vers les bords */
  .cta-dots {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(var(--cta-dot) 1px, transparent 1.2px);
    background-size: 22px 22px;
    background-position: center;
    -webkit-mask-image: radial-gradient(
      ellipse 70% 65% at 50% 45%,
      #000 20%,
      transparent 75%
    );
    mask-image: radial-gradient(
      ellipse 70% 65% at 50% 45%,
      #000 20%,
      transparent 75%
    );
  }
  .cta .eyebrow {
    color: var(--cta-accent);
  }
  .cta h2 {
    margin-top: 10px;
    color: var(--cta-text);
  }
  .cta p.lead-text {
    margin: 16px auto 36px;
    max-width: 30rem;
    color: var(--cta-text-2);
  }
  :global([data-theme="dark"]) .cta .btn-primary {
    background: #ffffff;
    color: #1d1d1f;
  }
  :global([data-theme="dark"]) .cta .btn-primary:hover {
    background: #e8e8ed;
  }

  /* ---------- Staggered reveal ---------- */
  .grid-3 > :nth-child(2) {
    --reveal-delay: 0.08s;
  }
  .grid-3 > :nth-child(3) {
    --reveal-delay: 0.16s;
  }
  .hero > :nth-child(3) {
    --reveal-delay: 0.08s;
  }
  .hero > :nth-child(4) {
    --reveal-delay: 0.16s;
  }
  .hero > :nth-child(5) {
    --reveal-delay: 0.24s;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1000px) {
    .grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 28px;
    }
  }
  @media (max-width: 860px) {
    .grid-3,
    .posts:has(> :only-child) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .hide-xs {
      display: none;
    }
  }

  /* ---------- Hero emphasis ---------- */
  .lead strong {
    color: var(--foreground);
    font-weight: 600;
  }

  /* ---------- Stats ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    padding: 32px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .stat {
    text-align: center;
  }
  .stat-value {
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat-unit {
    margin-inline-start: 4px;
    font-size: 0.45em;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--muted-foreground);
  }
  .stat-label {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted-foreground);
  }

  /* ---------- Expertise (2 × 2) ---------- */
  .grid-2 {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .grid-4 {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }
  .grid-4 > :nth-child(2) {
    --reveal-delay: 0.08s;
  }
  .grid-4 > :nth-child(3) {
    --reveal-delay: 0.16s;
  }
  .grid-4 > :nth-child(4) {
    --reveal-delay: 0.24s;
  }
  .grid-2 > :nth-child(2),
