---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const url = (path: string) => getRelativeLocaleUrl(locale, path);

const posts = getSortedPosts(await getCollection("posts")).slice(0, 3);

// Les boutons de contact pointent vers LinkedIn dès que l'URL est renseignée
// dans astro-paper.config.ts, sinon vers la page À propos.
const linkedin = config.socials.find(s => s.name === "linkedin")?.url;
const contactUrl = linkedin ?? url("about");
const contactAttrs = linkedin ? { target: "_blank", rel: "noopener" } : {};

// TODO : adapte ces trois blocs à tes services réels.
const services = [
  {
    title: "Applications web",
    text: "Des interfaces rapides, accessibles et soignées, du prototype à la mise en production.",
    icon: "M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm-1 4h18M7 7h.01M10 7h.01",
  },
  {
    title: "API & architecture",
    text: "Des fondations solides et lisibles, pensées pour évoluer avec votre produit sans dette inutile.",
    icon: "M12 3 3 7.5l9 4.5 9-4.5L12 3Zm-9 9 9 4.5 9-4.5M3 16.5 12 21l9-4.5",
  },
  {
    title: "Conseil & audit",
    text: "Un regard extérieur sur votre code et vos choix techniques, avec des recommandations concrètes.",
    icon: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14Zm9 16-4-4",
  },
];

// TODO : adapte ta méthode de travail.
const steps = [
  {
    n: "01",
    title: "Comprendre",
    text: "On clarifie ensemble le besoin, les contraintes et ce qui compte vraiment pour vos utilisateurs.",
  },
  {
    n: "02",
    title: "Construire",
    text: "Des itérations courtes, des démos régulières et un code propre, testé et documenté.",
  },
  {
    n: "03",
    title: "Livrer",
    text: "Mise en production sereine, passation claire et accompagnement après le lancement.",
  },
];
---

<Layout>
  <Header />

  <main id="main-content">
    <!-- Hero -->
    <section class="hero wide-layout">
      <div class="glow" aria-hidden="true"></div>
      <p class="pill reveal">
        <span class="dot" aria-hidden="true"></span>
        <span class="hide-xs">Développeur freelance ·</span> Disponible pour de nouvelles
        missions
      </p>
      <h1 class="reveal">
        Des produits numériques,<br />
        <span class="gradient-text">pensés avec soin.</span>
      </h1>
      <p class="lead-text lead reveal">
        J'accompagne les entreprises dans la conception et le développement de
        leurs applications, avec un souci constant de la qualité, de la
        simplicité et de l'expérience utilisateur.
      </p>
      <div class="actions reveal">
        <a href={contactUrl} class="btn-primary" {...contactAttrs}
          >Démarrer un projet</a
        >
        <a href={url("posts")} class="link-arrow">Lire le blog</a>
      </div>
    </section>

    <!-- Services -->
    <section class="section wide-layout">
      <p class="eyebrow reveal">Expertise</p>
      <h2 class="display-title reveal">Ce que je fais.</h2>
      <div class="grid-3">
        {
          services.map(s => (
            <article class="surface-card is-link card reveal">
              <span class="card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d={s.icon} />
                </svg>
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Méthode -->
    <section class="section wide-layout">
      <p class="eyebrow reveal">Méthode</p>
      <h2 class="display-title reveal">Simple. Transparent. Efficace.</h2>
      <ol class="grid-3 steps">
        {
          steps.map(s => (
            <li class="step reveal">
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Articles -->
    {
      posts.length > 0 && (
        <section class="section wide-layout">
          <div class="section-head">
            <div>
              <p class="eyebrow reveal">Le blog</p>
              <h2 class="display-title reveal">Derniers articles.</h2>
            </div>
            <a href={url("posts")} class="link-arrow reveal">
              Tous les articles
            </a>
          </div>
          <ul class="grid-3 posts">
            {posts.map(post => (
              <Card {...post} variant="h3" />
            ))}
          </ul>
        </section>
      )
    }

    <!-- CTA -->
    <section class="cta reveal">
      <div class="cta-aura" aria-hidden="true">
        <span class="blob blob-1"></span>
        <span class="blob blob-2"></span>
        <span class="blob blob-3"></span>
      </div>
      <p class="eyebrow">Travaillons ensemble</p>
      <h2 class="display-title">Un projet en tête&nbsp;?</h2>
      <p class="lead-text">
        Parlons de vos besoins, simplement et sans engagement.
      </p>
      <a href={contactUrl} class="btn-primary" {...contactAttrs}>Me contacter</a
      >
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-top: clamp(88px, 14vw, 168px);
    padding-bottom: clamp(48px, 7vw, 96px);
    text-align: center;
  }
  .glow {
    position: absolute;
    inset: -10% -20% auto;
    height: 720px;
    background: var(--glow);
    filter: blur(20px);
    z-index: -1;
    pointer-events: none;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 980px;
    background: var(--surface);
    color: var(--muted-foreground);
    font-size: 13px;
    box-shadow: var(--shadow-card);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent);
  }
  .hero h1 {
    margin: 28px auto 0;
    font-size: clamp(42px, 8vw, 88px);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.045em;
    max-width: 14ch;
  }
  .lead {
    margin: 28px auto 0;
    max-width: 38rem;
  }
  .actions {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px 28px;
  }

  /* ---------- Sections ---------- */
  .section {
    padding-top: clamp(64px, 9vw, 112px);
  }
  .section h2 {
    margin-top: 8px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
  }
  .grid-3 {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .card {
    padding: 32px 28px 36px;
  }
  .card-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }
  .card-icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .card h3,
  .step h3 {
    margin-top: 22px;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .card p,
  .step p {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted-foreground);
  }
  .step {
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .step-n {
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
  }
  .step h3 {
    margin-top: 12px;
  }
  .posts {
    margin-top: 40px;
  }
  .posts:has(> :only-child) {
    grid-template-columns: minmax(0, 640px);
  }

  /* ---------- CTA ---------- */
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: min(calc(100% - 40px), calc(var(--max-wide) - 40px));
    margin: clamp(80px, 11vw, 136px) auto 0;
    padding: clamp(64px, 9vw, 112px) 24px;
    text-align: center;
    background: var(--surface);
    border-radius: 32px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
  }
  .cta h2 {
    margin-top: 10px;
  }
  .cta p.lead-text {
    margin: 14px auto 32px;
    max-width: 30rem;
  }

  /* Halos de couleur flous derrière le contenu */
  .cta-aura {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .blob {
    position: absolute;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(70px);
    opacity: var(--blob-opacity, 0.35);
    animation: drift 18s ease-in-out infinite alternate;
  }
  .blob-1 {
    top: -30%;
    left: -8%;
    background: #0071e3;
  }
  .blob-2 {
    bottom: -35%;
    right: -6%;
    background: #e0457b;
    animation-delay: -6s;
    animation-duration: 22s;
  }
  .blob-3 {
    top: 10%;
    left: 34%;
    width: 34%;
    background: #7a5cff;
    opacity: calc(var(--blob-opacity, 0.35) * 0.8);
    animation-delay: -12s;
    animation-duration: 26s;
  }
  :global([data-theme="dark"]) .cta {
    --blob-opacity: 0.45;
    background: #0a0a0c;
  }
  :global([data-theme="dark"]) .blob-1 {
    background: #2997ff;
  }
  :global([data-theme="dark"]) .blob-2 {
    background: #ff6b9a;
  }
  :global([data-theme="dark"]) .blob-3 {
    background: #a78bfa;
  }

  @keyframes drift {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(6%, 8%) scale(1.08);
    }
    100% {
      transform: translate(-6%, -4%) scale(0.95);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
    }
  }

  /* ---------- Staggered reveal ---------- */
  .grid-3 > :nth-child(2) {
    --reveal-delay: 0.08s;
  }
  .grid-3 > :nth-child(3) {
    --reveal-delay: 0.16s;
  }
  .hero > :nth-child(3) {
    --reveal-delay: 0.08s;
  }
  .hero > :nth-child(4) {
    --reveal-delay: 0.16s;
  }
  .hero > :nth-child(5) {
    --reveal-delay: 0.24s;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 860px) {
    .grid-3,
    .posts:has(> :only-child) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .hide-xs {
      display: none;
    }
  }
</style>
