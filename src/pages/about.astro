---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import {
  PERSON_ID,
  WEBSITE_ID,
  aboutUrl,
  personSchema,
  websiteSchema,
} from "@/utils/schema";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": aboutUrl,
      url: aboutUrl,
      name: about.data.title,
      inLanguage: "fr-FR",
      mainEntity: { "@id": PERSON_ID },
      isPartOf: { "@id": WEBSITE_ID },
    },
    personSchema,
    websiteSchema,
  ],
};
---

<Layout
  title="À propos de Naofel El Alouani, ingénieur logiciel freelance"
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
  ogType="profile"
  jsonLd={jsonLd}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
