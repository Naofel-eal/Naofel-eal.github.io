---
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

{
  (prevPost || nextPost) && (
    <nav data-pagefind-ignore class="adjacent" aria-label="Autres articles">
      {prevPost && (
        <a
          href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
          class="surface-card adj"
        >
          <span class="adj-label">‹ {t.post.previousPost}</span>
          <span class="adj-title">{prevPost.title}</span>
        </a>
      )}
      {nextPost && (
        <a
          href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
          class="surface-card adj adj-next"
        >
          <span class="adj-label">{t.post.nextPost} ›</span>
          <span class="adj-title">{nextPost.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .adjacent {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .adj {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 24px;
  }
  .adj-next {
    grid-column: 2;
    text-align: end;
  }
  .adj-label {
    font-size: 13px;
    color: var(--accent);
  }
  .adj-title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  @media (max-width: 640px) {
    .adjacent {
      grid-template-columns: minmax(0, 1fr);
    }
    .adj-next {
      grid-column: auto;
    }
  }
</style>
