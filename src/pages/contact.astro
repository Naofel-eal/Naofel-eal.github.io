---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import portrait from "@/assets/images/naofel-parlons.jpg";
import config from "@/config";

// L'e-mail est découpé pour ne pas apparaître en clair dans le HTML
// (protection simple contre les robots qui collectent les adresses).
const email = { user: "naofel.eal", domain: "gmail.com" };
const calendly = "https://calendly.com/naofel-eal/30min";
const malt = "https://www.malt.fr/profile/naofelelalouani";
const linkedin =
  config.socials.find(s => s.name === "linkedin")?.url ??
  "https://www.linkedin.com/in/naofel-el-alouani-83a947197/";

const missions = [
  "Agents IA",
  "Architecture & DDD",
  "Full-stack Java · Angular",
  "Accompagnement d'équipe",
  "Cybersécurité",
];
---

<Layout
  title={`Contact | ${config.site.title}`}
  description="Contacter Naofel El Alouani, ingénieur logiciel senior freelance : appel de 30 minutes, e-mail, LinkedIn et Malt."
>
  <Header />

  <main id="main-content" class="contact wide-layout">
    <figure class="portrait reveal">
      <Image
        src={portrait}
        alt="Naofel El Alouani au micro, pendant son discours de major de promotion à Polytech Dijon en 2025"
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 860px) 100vw, 440px"
        loading="eager"
        class="portrait-img"
      />
      <figcaption>
        Discours de major de promotion, Polytech Dijon, 2025
      </figcaption>
    </figure>

    <div class="content">
      <p class="status reveal">
        <span class="dot" aria-hidden="true"></span>
        Disponible dès maintenant · Remote ou hybride
      </p>

      <h1 class="title reveal">
        Parlons&#8209;en<span class="title-dot">.</span>
      </h1>

      <p class="intro reveal">
        Un projet d'agents IA, une architecture à remettre d'aplomb ou un
        produit à lancer&nbsp;? Je lis et je réponds moi-même à chaque message.
        La date de démarrage, on la cale ensemble.
      </p>

      <div class="booking reveal">
        <a
          href={calendly}
          class="btn-primary btn-big"
          target="_blank"
          rel="noopener"
        >
          Réserver un appel de 30&nbsp;min
        </a>
        <p class="booking-note">Le plus rapide. Gratuit et sans engagement.</p>
      </div>

      <ul class="lines reveal" aria-label="Autres moyens de contact">
        <li class="line">
          <span class="line-label">E-mail</span>
          <span class="line-value">
            <a
              class="line-link email-address"
              data-mailto
              data-user={email.user}
              data-domain={email.domain}
              href="#"
            >
              <noscript>{email.user} [arobase] {email.domain}</noscript>
            </a>
          </span>
          <button type="button" class="copy-email" data-copy-email>
            <span class="ce-icon" aria-hidden="true">
              <svg class="i-copy" viewBox="0 0 24 24">
                <rect x="8" y="8" width="12" height="12" rx="2.5"></rect>
                <path
                  d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8"
                ></path>
              </svg>
              <svg class="i-check" viewBox="0 0 24 24">
                <path d="M5 12.5l4.5 4.5L19 7.5" pathLength="1"></path>
              </svg>
            </span>
            <span class="ce-label">Copier</span>
            <span class="sr-only" aria-live="polite"></span>
          </button>
        </li>
        <li class="line">
          <span class="line-label">LinkedIn</span>
          <span class="line-value">
            <a class="line-link" href={linkedin} target="_blank" rel="noopener"
              >Naofel El Alouani</a
            >
          </span>
          <span class="line-arrow" aria-hidden="true">↗</span>
        </li>
        <li class="line">
          <span class="line-label">Malt</span>
          <span class="line-value">
            <a class="line-link" href={malt} target="_blank" rel="noopener"
              >Profil freelance</a
            >
          </span>
          <span class="line-arrow" aria-hidden="true">↗</span>
        </li>
      </ul>

      <p class="hint reveal">
        Pour gagner du temps, dites-moi en quelques lignes <strong
          >votre contexte</strong
        >, <strong>votre objectif</strong> et <strong>votre calendrier</strong>.
      </p>

      <p class="missions reveal">
        {
          missions.map((m, i) => (
            <>
              {i > 0 && (
                <span class="sep" aria-hidden="true">
                  ·
                </span>
              )}
              <span>{m}</span>
            </>
          ))
        }
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  function initContact() {
    const link = document.querySelector<HTMLAnchorElement>(".email-address");
    if (!link) return;
    const email = `${link.dataset.user}@${link.dataset.domain}`;
    link.textContent = email;
    link.href = `mailto:${email}`;

    const btn = document.querySelector<HTMLButtonElement>("[data-copy-email]");
    if (!btn) return;
    const label = btn.querySelector(".ce-label");
    const live = btn.querySelector("[aria-live]");
    let timer: ReturnType<typeof setTimeout> | undefined;

    btn.addEventListener("click", async () => {
      clearTimeout(timer);
      btn.classList.remove("is-copied", "is-error");
      void btn.offsetWidth; // rejoue l'animation à chaque clic
      try {
        await navigator.clipboard.writeText(email);
        btn.classList.add("is-copied");
        if (label) label.textContent = "Copié";
        if (live) live.textContent = "Adresse e-mail copiée";
      } catch {
        btn.classList.add("is-error");
        if (label) label.textContent = "Échec";
        if (live) live.textContent = "Impossible de copier l'adresse";
      }
      timer = setTimeout(() => {
        btn.classList.remove("is-copied", "is-error");
        if (label) label.textContent = "Copier";
        if (live) live.textContent = "";
      }, 2000);
    });
  }
  document.addEventListener("astro:page-load", initContact);
</script>

<style>
  /* ---------- Mise en page : photo à gauche, texte à droite ---------- */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 440px) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 96px);
    align-items: start;
    padding-top: clamp(48px, 7vw, 88px);
  }

  .portrait {
    position: sticky;
    top: 84px;
    margin: 0;
  }
  .portrait :global(.portrait-img) {
    display: block;
    width: 100%;
    aspect-ratio: 27 / 40;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 28px;
    box-shadow: var(--shadow-card);
  }
  .portrait figcaption {
    margin-top: 12px;
    font-size: 13px;
    color: var(--muted-foreground);
  }

  .content {
    container-type: inline-size;
    padding-top: clamp(8px, 3vw, 40px);
  }

  /* ---------- Statut ---------- */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted-foreground);
  }
  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }
  .dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--ok);
    animation: ping 2.4s var(--ease-out) infinite;
  }
  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    80%,
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  /* ---------- Titre ---------- */
  .title {
    margin-top: 18px;
    font-size: clamp(52px, 17cqi, 136px);
    line-height: 0.92;
    font-weight: 700;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .title-dot {
    color: var(--accent);
  }
  .intro {
    margin-top: 32px;
    max-width: 34rem;
    font-size: clamp(19px, 2.2vw, 23px);
    line-height: 1.5;
    letter-spacing: -0.015em;
    color: var(--muted-foreground);
  }

  /* ---------- Rendez-vous ---------- */
  .booking {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .btn-big {
    font-size: 18px;
    padding: 15px 28px;
  }
  .booking-note {
    font-size: 14px;
    color: var(--muted-foreground);
  }

  /* ---------- Lignes de contact ---------- */
  .lines {
    margin-top: 56px;
    border-top: 1px solid var(--border);
  }
  .line {
    position: relative;
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
  }
  .line-label {
    font-size: 14px;
    color: var(--muted-foreground);
  }
  .line-value {
    min-width: 0;
  }
  .line-link {
    font-size: clamp(19px, 2.4vw, 26px);
    font-weight: 600;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1.5px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition:
      color 0.2s ease,
      background-size 0.35s var(--ease-out);
  }
  .line:hover .line-link,
  .line-link:focus-visible {
    color: var(--accent);
    background-size: 100% 1.5px;
  }
  /* Toute la ligne est cliquable pour LinkedIn et Malt */
  .line:not(:first-child) .line-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .line-arrow {
    font-size: 22px;
    color: var(--muted-foreground);
    transition:
      transform 0.3s var(--ease-out),
      color 0.2s ease;
  }
  .line:hover .line-arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  /* Bouton « Copier » */
  .copy-email {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 13px 0 11px;
    border-radius: 980px;
    background: var(--muted);
    color: var(--foreground);
    font-size: 13px;
    font-weight: 500;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s var(--ease-out);
  }
  .copy-email:hover {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
  }
  .copy-email:active {
    transform: scale(0.95);
  }
  .ce-icon {
    display: grid;
    width: 14px;
    height: 14px;
  }
  .ce-icon svg {
    grid-area: 1 / 1;
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 0.2s ease,
      transform 0.35s var(--ease-out);
  }
  .i-check {
    opacity: 0;
    transform: scale(0.6);
  }
  .i-check path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .copy-email.is-copied {
    background: color-mix(in srgb, var(--ok) 14%, transparent);
    color: var(--ok);
    animation: ce-pop 0.45s var(--ease-out);
  }
  .copy-email.is-copied .i-copy {
    opacity: 0;
    transform: scale(0.6) rotate(-20deg);
  }
  .copy-email.is-copied .i-check {
    opacity: 1;
    transform: none;
  }
  .copy-email.is-copied .i-check path {
    animation: ce-draw 0.4s 0.08s var(--ease-out) forwards;
  }
  .copy-email.is-copied .ce-label,
  .copy-email.is-error .ce-label {
    animation: ce-label 0.3s var(--ease-out);
  }
  .copy-email.is-error {
    color: #ff453a;
    background: color-mix(in srgb, #ff453a 12%, transparent);
    animation: ce-shake 0.4s ease;
  }
  @keyframes ce-pop {
    40% {
      transform: scale(1.06);
    }
  }
  @keyframes ce-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes ce-label {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  @keyframes ce-shake {
    25% {
      transform: translateX(-3px);
    }
    75% {
      transform: translateX(3px);
    }
  }

  /* ---------- Fin de page ---------- */
  .hint {
    margin-top: 40px;
    max-width: 34rem;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted-foreground);
  }
  .hint strong {
    color: var(--foreground);
    font-weight: 600;
  }
  .missions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--foreground);
  }
  .sep {
    color: var(--muted-foreground);
  }

  /* ---------- Apparition décalée ---------- */
  .content > :nth-child(2) {
    --reveal-delay: 0.06s;
  }
  .content > :nth-child(3) {
    --reveal-delay: 0.12s;
  }
  .content > :nth-child(4) {
    --reveal-delay: 0.18s;
  }
  .content > :nth-child(5) {
    --reveal-delay: 0.24s;
  }

  @media (prefers-reduced-motion: reduce) {
    .dot::after,
    .copy-email,
    .copy-email .ce-label,
    .ce-icon svg {
      animation: none !important;
      transition: none;
    }
    .copy-email.is-copied .i-check path {
      stroke-dashoffset: 0;
    }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 860px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      padding-top: 32px;
    }
    .portrait {
      position: static;
    }
    .portrait :global(.portrait-img) {
      aspect-ratio: 4 / 3;
      object-position: 50% 15%;
    }
    .content {
      padding-top: 0;
    }
  }
  @media (max-width: 480px) {
    .line {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 12px;
    }
    .line-label {
      grid-column: 1 / -1;
    }
  }
</style>
