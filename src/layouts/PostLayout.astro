---
import Layout from "./Layout.astro";
import config from "@/config";
import {
  PERSON_ID,
  WEBSITE_ID,
  aboutUrl,
  personSchema,
  websiteSchema,
} from "@/utils/schema";

type Props = {
  /** Contenu de la balise <title> (peut inclure le nom du site). */
  title?: string;
  /** Titre de l'article seul, utilisé dans les données structurées. */
  headline: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
  wordCount?: number;
  /** URL de la version originale, si l'article est une traduction. */
  originalURL?: string;
};

const {
  title,
  headline,
  description,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  canonicalURL: canonicalProp,
  pubDatetime,
  modDatetime,
  tags = [],
  wordCount,
  originalURL,
} = Astro.props;

const canonical = canonicalProp ?? new URL(Astro.url.pathname, Astro.site).href;
const postsUrl = new URL("posts/", config.site.url).href;
const modified = modDatetime ?? pubDatetime;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${canonical}#article`,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      headline,
      ...(description && { description }),
      ...(ogImage && { image: [ogImage] }),
      ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
      ...(modified && { dateModified: modified.toISOString() }),
      inLanguage: "fr-FR",
      ...(tags.length > 0 && {
        keywords: tags.join(", "),
        articleSection: tags[0],
      }),
      ...(wordCount && { wordCount }),
      author: { "@id": PERSON_ID },
      publisher: { "@id": PERSON_ID },
      isPartOf: { "@id": WEBSITE_ID },
      ...(originalURL && {
        isBasedOn: originalURL,
        translationOfWork: {
          "@type": "BlogPosting",
          url: originalURL,
          inLanguage: "en",
        },
      }),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Accueil",
          item: config.site.url,
        },
        { "@type": "ListItem", position: 2, name: "Articles", item: postsUrl },
        { "@type": "ListItem", position: 3, name: headline, item: canonical },
      ],
    },
    personSchema,
    websiteSchema,
  ],
};
---

<Layout
  {title}
  {description}
  {ogImage}
  {ogImageAlt}
  {ogImageWidth}
  {ogImageHeight}
  canonicalURL={canonical}
  ogType="article"
  jsonLd={structuredData}
>
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modified && (
        <meta
          property="article:modified_time"
          content={modified.toISOString()}
        />
      )
    }
    <meta property="article:author" content={aboutUrl} />
    {tags[0] && <meta property="article:section" content={tags[0]} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <slot />
</Layout>
