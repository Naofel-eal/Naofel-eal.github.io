---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);
---

{
  page.lastPage > 1 && (
    <nav class="pager app-layout" aria-label="Pagination">
      {page.url.prev ? (
        <a
          href={page.url.prev}
          class="btn-secondary"
          aria-label={t.a11y.goToPreviousPage}
        >
          ‹ {t.pagination.prev}
        </a>
      ) : (
        <span class="btn-secondary is-disabled" aria-hidden="true">
          ‹ {t.pagination.prev}
        </span>
      )}
      <span class="count">
        {page.currentPage} / {page.lastPage}
      </span>
      {page.url.next ? (
        <a
          href={page.url.next}
          class="btn-secondary"
          aria-label={t.a11y.goToNextPage}
        >
          {t.pagination.next} ›
        </a>
      ) : (
        <span class="btn-secondary is-disabled" aria-hidden="true">
          {t.pagination.next} ›
        </span>
      )}
    </nav>
  )
}

<style>
  .pager {
    margin-top: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }
  .count {
    font-size: 14px;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }
  .is-disabled {
    opacity: 0.4;
    pointer-events: none;
  }
</style>
