---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { formatPostDate } from "@/utils/formatPostDate";
import { tagSlug } from "@/utils/tags";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const { title, description, pubDatetime, modDatetime, timezone, tags } = data;
const isModified = modDatetime && modDatetime > pubDatetime;
const date = isModified ? modDatetime : pubDatetime;
---

<li class="card-item reveal" data-tags={tags.map(tagSlug).join(" ")}>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="surface-card group card-link"
  >
    <time datetime={date.toISOString()}>
      {isModified && "Mis à jour le "}{formatPostDate(date, timezone)}
    </time>
    <Heading transition:name={toTransitionName(id)} class="card-title">
      {title}
    </Heading>
    <p class="card-desc">{description}</p>
    {
      tags.length > 0 && (
        <ul class="card-tags" aria-label="Sujets">
          {tags.map(t => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }
    <span class="link-arrow card-more">Lire l'article</span>
  </a>
</li>

<style>
  .card-item {
    list-style: none;
  }
  .card-item:not(:last-child) {
    margin-bottom: 16px;
  }
  :global(.grid-3) > .card-item {
    margin-bottom: 0;
  }
  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px;
  }
  time {
    font-size: 13px;
    color: var(--muted-foreground);
  }
  .card-title {
    margin-top: 10px;
    font-size: 21px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .card-desc {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted-foreground);
    flex: 1;
  }
  .card-tags {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .card-tags li {
    padding: 3px 10px;
    border-radius: 980px;
    background: var(--muted);
    font-size: 12px;
    font-weight: 500;
    color: var(--foreground);
  }
  .card-more {
    margin-top: 20px;
    font-size: 15px;
  }
</style>
