---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const url = (path: string) => getRelativeLocaleUrl(locale, path);
const year = new Date().getFullYear();

const label = (name: string) =>
  name === "linkedin"
    ? "LinkedIn"
    : name === "github"
      ? "GitHub"
      : name === "mail"
        ? "E-mail"
        : name.charAt(0).toUpperCase() + name.slice(1);
---

<footer
  class:list={["site-footer", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="wide-layout footer-inner">
    <p>© {year} {config.site.author}</p>
    <nav aria-label="Liens secondaires">
      <a href={url("posts")}>{t.nav.posts}</a>
      {
        config.features.showArchives && (
          <a href={url("archives")}>{t.nav.archives}</a>
        )
      }
      <a href={url("about")}>{t.nav.about}</a>
      {
        config.socials.map(s => (
          <a href={s.url} target="_blank" rel="noopener">
            {label(s.name)}
          </a>
        ))
      }
      <a href={getAssetPath("rss.xml")}>RSS</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: 72px;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 20px;
    padding-bottom: 40px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--muted-foreground);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  a {
    transition: color 0.2s ease;
  }
  a:hover {
    color: var(--foreground);
  }
</style>
