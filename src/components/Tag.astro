---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={["chip", { "chip-lg": size === "lg" }]}
  >
    <span class="hash" aria-hidden="true">#</span>{tagName}
  </a>
</li>

<style>
  .chip-lg {
    font-size: 15px;
    padding: 8px 16px;
  }
  .hash {
    opacity: 0.5;
  }
</style>
