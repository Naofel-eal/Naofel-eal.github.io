---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const url = (path: string) => getRelativeLocaleUrl(locale, path);

const relativePath = stripBase(Astro.url.pathname);
const currentPath = stripLocale(
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath,
  locale
);
const isActive = (path: string) =>
  currentPath.split("/").filter(Boolean)[0] ===
  path.split("/").filter(Boolean)[0];

const contactUrl = url("contact");

const links = [
  { href: url("posts"), label: t.nav.posts, path: "/posts" },
  { href: url("about"), label: t.nav.about, path: "/about" },
];
---

<a id="skip-to-content" href="#main-content" class="skip-link">
  {t.a11y.skipToContent}
</a>

<header class="site-nav">
  <nav class="wide-layout nav-inner" aria-label="Navigation principale">
    <a href={url("")} class="brand">{site.title}</a>

    <div class="nav-right">
      <ul id="menu-items" class="nav-links">
        {
          links.map(l => (
            <li>
              <a
                href={l.href}
                class:list={{ "active-nav": isActive(l.path) }}
                aria-current={isActive(l.path) ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="mobile-only">
          <a href={contactUrl}>Contact</a>
        </li>
      </ul>

      {
        features.search !== false && (
          <a
            href={url("search")}
            class="icon-btn"
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
          </a>
        )
      }

      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="icon-btn"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
          </button>
        )
      }

      <a href={contactUrl} class="nav-cta">Contact</a>

      <button
        id="menu-btn"
        class="icon-btn menu-btn"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path class="bar-top" d="M4 8h16"></path>
          <path class="bar-bottom" d="M4 16h16"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: 16px;
    top: -100px;
    z-index: 60;
    padding: 8px 14px;
    border-radius: 980px;
    background: var(--surface);
    color: var(--accent);
    box-shadow: var(--shadow-card);
    transition: top 0.2s ease;
  }
  .skip-link:focus {
    top: 10px;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    position: relative;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-inline-end: 14px;
    font-size: 13px;
  }
  .nav-links a {
    color: var(--muted-foreground);
    transition: color 0.2s ease;
  }
  .nav-links a:hover {
    color: var(--foreground);
  }
  .nav-cta {
    margin-inline-start: 8px;
    background: var(--foreground);
    color: var(--background);
    padding: 6px 14px;
    border-radius: 980px;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .nav-cta:hover {
    opacity: 0.85;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--muted-foreground);
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }
  .icon-btn:hover {
    color: var(--foreground);
    background: var(--border);
  }
  .icon-btn svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-sun {
    display: none;
  }
  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }
  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }

  .menu-btn,
  .mobile-only {
    display: none;
  }
  .menu-btn path {
    transition: transform 0.3s var(--ease-out);
    transform-origin: center;
  }
  .menu-btn[aria-expanded="true"] .bar-top {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] .bar-bottom {
    transform: translateY(-4px) rotate(-45deg);
  }

  @media (max-width: 640px) {
    .menu-btn {
      display: grid;
    }
    .mobile-only {
      display: block;
    }
    .nav-cta {
      display: none;
    }
    .nav-links {
      position: absolute;
      top: 52px;
      left: 0;
      right: 0;
      margin: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 20px 20px;
      background: var(--background);
      border-bottom: 1px solid var(--border);
      font-size: 24px;
      font-weight: 600;
      letter-spacing: -0.02em;
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      visibility: hidden;
      transition:
        opacity 0.3s var(--ease-out),
        transform 0.3s var(--ease-out),
        visibility 0.3s;
    }
    .nav-links.is-open {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      visibility: visible;
    }
    .nav-links a {
      display: block;
      padding: 10px 0;
      color: var(--foreground);
    }
  }
</style>

<script>
  function setupNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    if (!menuBtn || !menuItems) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", String(!isOpen));
      menuBtn.setAttribute("aria-label", isOpen ? openLabel : closeLabel);
      menuItems.classList.toggle("is-open", !isOpen);
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    skipLink?.addEventListener("click", e => {
      if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (!target) return;
      target.setAttribute("tabindex", "-1");
      target.addEventListener(
        "blur",
        () => target.removeAttribute("tabindex"),
        {
          once: true,
        }
      );
      target.focus();
      target.scrollIntoView({ behavior: "smooth" });
    });
  }

  setupNav();
  handleSkipToContent();
  document.addEventListener("astro:after-swap", () => {
    setupNav();
    handleSkipToContent();
  });
</script>
